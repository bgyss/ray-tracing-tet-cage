+/* Tet-cage AABB candidates are narrowed with the ordinary Cycles triangle data. This first
+ * Blender landing is static-only; motion remains on the existing MetalRT path until its query
+ * bindings are qualified. */
+ccl_device_intersect bool scene_intersect_tetcage_query(KernelGlobals kg,
+                                                        const ccl_private Ray *ray,
+                                                        const uint visibility,
+                                                        ccl_private Intersection *isect)
+{
+#  ifdef __METALRT_MOTION__
+  (void)kg;
+  (void)ray;
+  (void)visibility;
+  (void)isect;
+  return false;
+#  else
+  (void)kg;
+  metal::raytracing::ray query_ray(ray->P, ray->D, ray->tmin, ray->tmax);
+  metal::raytracing::intersection_params params;
+  params.force_opacity(metal::raytracing::forced_opacity::non_opaque);
+  params.assume_geometry_type(metal::raytracing::geometry_type::triangle |
+                              metal::raytracing::geometry_type::bounding_box);
+
+  metal::raytracing::intersection_query<instancing> query(
+      query_ray, metal_ancillaries->accel_struct, params);
+
+  bool found = false;
+  float closest_t = ray->tmax;
+  Intersection closest = {};
+  while (query.next()) {
+    const auto candidate_type = query.get_candidate_intersection_type();
+    if (candidate_type != intersection_type::triangle &&
+        candidate_type != intersection_type::bounding_box)
+    {
+      continue;
+    }
+
+    const int object = query.get_candidate_instance_id();
+    const bool is_tetcage = (kernel_data_fetch(object_flag, object) & SD_OBJECT_TETCAGE) != 0;
+    if ((candidate_type == intersection_type::bounding_box) != is_tetcage) {
+      continue;
+    }
+
+    const int prim = query.get_candidate_primitive_id() +
+                     kernel_data_fetch(object_prim_offset, object);
+#    ifdef __VISIBILITY_FLAG__
+    if (!(kernel_data_fetch(objects, object).visibility & visibility)) {
+      continue;
+    }
+#    endif
+
+    float3 local_P = query_ray.origin;
+    float3 local_D = query_ray.direction;
+    if (!(kernel_data_fetch(object_flag, object) & SD_OBJECT_TRANSFORM_APPLIED)) {
+      float3 idir;
+      bvh_instance_push(nullptr, object, ray, &local_P, &local_D, &idir);
+    }
+
+    float candidate_t;
+    float candidate_u;
+    float candidate_v;
+    const int position_offset = kernel_data_fetch(objects, object).position_offset;
+    const uint3 tri_vindex = kernel_data_fetch(tri_vindex, prim);
+    const float3 tri_a = kernel_data_fetch(tri_verts, position_offset + tri_vindex.x);
+    const float3 tri_b = kernel_data_fetch(tri_verts, position_offset + tri_vindex.y);
+    const float3 tri_c = kernel_data_fetch(tri_verts, position_offset + tri_vindex.z);
+    if (!ray_triangle_intersect(local_P,
+                                local_D,
+                                ray->tmin,
+                                closest_t,
+                                tri_a,
+                                tri_b,
+                                tri_c,
+                                &candidate_u,
+                                &candidate_v,
+                                &candidate_t))
+    {
+      continue;
+    }
+
+    if (!found || candidate_t < closest_t) {
+      found = true;
+      closest_t = candidate_t;
+      closest.object = object;
+      closest.prim = prim;
+      closest.type = is_tetcage ? PRIMITIVE_TRIANGLE :
+                                  kernel_data_fetch(objects, object).primitive_type;
+      closest.u = candidate_u;
+      closest.v = candidate_v;
+      closest.t = candidate_t;
+    }
+  }
+
+  if (found) {
+    *isect = closest;
+  }
+  return found;
+#  endif
+}
