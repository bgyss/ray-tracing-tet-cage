+/* Watertight projected-axis triangle test for the native tet-cage paths. Metal's built-in triangle
+ * intersector uses the same projected-edge family; keeping this separate from Cycles' historical
+ * Pluecker helper limits the precision seam to the procedural candidate. */
+ccl_device_forceinline bool metal_tetcage_ray_triangle_intersect(const float3 ray_P,
+                                                                 const float3 ray_D,
+                                                                 const float ray_tmin,
+                                                                 const float ray_tmax,
+                                                                 const float3 tri_a,
+                                                                 const float3 tri_b,
+                                                                 const float3 tri_c,
+                                                                 ccl_private float *isect_u,
+                                                                 ccl_private float *isect_v,
+                                                                 ccl_private float *isect_t)
+{
+  const float3 A = tri_a - ray_P;
+  const float3 B = tri_b - ray_P;
+  const float3 C = tri_c - ray_P;
+
+  int kz = 0;
+  if (fabsf(ray_D.y) > fabsf(ray_D[kz])) {
+    kz = 1;
+  }
+  if (fabsf(ray_D.z) > fabsf(ray_D[kz])) {
+    kz = 2;
+  }
+  if (ray_D[kz] == 0.0f) {
+    return false;
+  }
+  int kx = (kz + 1) % 3;
+  int ky = (kx + 1) % 3;
+  if (ray_D[kz] < 0.0f) {
+    const int tmp = kx;
+    kx = ky;
+    ky = tmp;
+  }
+
+  const float Sx = ray_D[kx] / ray_D[kz];
+  const float Sy = ray_D[ky] / ray_D[kz];
+  const float Sz = 1.0f / ray_D[kz];
+  const float Ax = fma(-Sx, A[kz], A[kx]);
+  const float Ay = fma(-Sy, A[kz], A[ky]);
+  const float Bx = fma(-Sx, B[kz], B[kx]);
+  const float By = fma(-Sy, B[kz], B[ky]);
+  const float Cx = fma(-Sx, C[kz], C[kx]);
+  const float Cy = fma(-Sy, C[kz], C[ky]);
+
+  const float U = Cx * By - Cy * Bx;
+  const float V = Ax * Cy - Ay * Cx;
+  const float W = Bx * Ay - By * Ax;
+  if ((U < 0.0f || V < 0.0f || W < 0.0f) && (U > 0.0f || V > 0.0f || W > 0.0f)) {
+    return false;
+  }
+
+  const float det = U + V + W;
+  if (det == 0.0f) {
+    return false;
+  }
+  const float Az = Sz * A[kz];
+  const float Bz = Sz * B[kz];
+  const float Cz = Sz * C[kz];
+  const float T = U * Az + V * Bz + W * Cz;
+  const float t = T / det;
+  if (!(t >= ray_tmin && t <= ray_tmax)) {
+    return false;
+  }
+
+  const float inv_det = 1.0f / det;
+  *isect_u = clamp(V * inv_det, 0.0f, 1.0f);
+  *isect_v = clamp(W * inv_det, 0.0f, 1.0f);
+  *isect_t = t;
+  return true;
+}
+
+#ifdef __BVH_LOCAL__
+/* Record tet-cage local hits with the same projected-axis narrow phase used by camera and shadow
+ * rays. Keeping the hit-record policy in Cycles' shared helper preserves reservoir sampling while
+ * avoiding a second, non-watertight triangle predicate for SSS and bevel queries. */
+ccl_device_inline bool metal_tetcage_triangle_intersect_local_vertices(
+    ccl_private LocalIntersection *local_isect,
+    const float3 P,
+    const float3 dir,
+    const int object,
+    const int prim,
+    const float tmin,
+    const float tmax,
+    const float3 tri_a,
+    const float3 tri_b,
+    const float3 tri_c,
+    ccl_private uint *lcg_state,
+    const int max_hits)
+{
+  float t;
+  float u;
+  float v;
+  if (!metal_tetcage_ray_triangle_intersect(P, dir, tmin, tmax, tri_a, tri_b, tri_c, &u, &v, &t)) {
+    return false;
+  }
+
+  if (max_hits == 0) {
+    return true;
+  }
+
+  const int hit_index = local_intersect_get_record_index(local_isect, t, lcg_state, max_hits);
+  if (hit_index == -1) {
+    return false;
+  }
+
+  ccl_private Intersection *isect = &local_isect->hits[hit_index];
+  isect->prim = prim;
+  isect->object = object;
+  isect->type = PRIMITIVE_TRIANGLE;
+  isect->u = u;
+  isect->v = v;
+  isect->t = t;
+  local_isect->Ng[hit_index] = normalize(cross(tri_b - tri_a, tri_c - tri_a));
+  return true;
+}
