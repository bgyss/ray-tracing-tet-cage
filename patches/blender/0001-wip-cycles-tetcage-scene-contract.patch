+/* SPDX-FileCopyrightText: 2026 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+#include <cstdint>
+
+#include "util/transform.h"
+#include "util/types.h"
+#include "util/vector.h"
+
+CCL_NAMESPACE_BEGIN
+
+/* Immutable local-space micro-triangle and its source identity.
+ *
+ * The primitive is intentionally independent from a frame's tetrahedron transforms. This keeps
+ * topology and provenance stable while an importer updates only per-frame affine transforms. */
+struct TetCageMicroTriangle {
+  uint32_t tetrahedron_index;
+  uint32_t source_primitive_id;
+  uint32_t source_triangle_id;
+  uint32_t micro_triangle_id;
+  float3 vertices[3];
+};
+
+/* Status reported by the importer or a future device backend when the native path is unavailable.
+ */
+enum class TetCageFallbackState : uint8_t {
+  NONE,
+  REQUESTED,
+  ACTIVE,
+};
+
+/* Scene-side transport contract for tet-cage geometry.
+ *
+ * This is not a Geometry subclass yet: no BVH builder, kernel primitive, or device backend
+ * consumes it. Keeping the contract separate prevents it from being mistaken for PointCloud data
+ * before the renderer-side implementation can preserve its source-hit provenance. */
+class TetCageGeometry {
+ public:
+  bool set_micro_triangles(const vector<TetCageMicroTriangle> &micro_triangles,
+                           uint32_t tetrahedron_count);
+  bool set_frame_tetrahedron_transforms(const vector<Transform> &tetrahedron_transforms);
+
+  void set_fallback_state(TetCageFallbackState fallback_state);
+
+  bool has_micro_triangles() const;
+  uint32_t tetrahedron_count() const;
+  const vector<TetCageMicroTriangle> &micro_triangles() const;
+  const vector<Transform> &frame_tetrahedron_transforms() const;
+  TetCageFallbackState fallback_state() const;
+
+ private:
+  bool micro_triangles_initialized_ = false;
+  uint32_t tetrahedron_count_ = 0;
+  vector<TetCageMicroTriangle> micro_triangles_;
+  vector<Transform> frame_tetrahedron_transforms_;
+  TetCageFallbackState fallback_state_ = TetCageFallbackState::NONE;
+};
+
+CCL_NAMESPACE_END
