@@ -347,6 +347,57 @@ Mesh::Mesh(const NodeType *node_type, Type geom_type_)
 
 Mesh::Mesh() : Mesh(get_node_type(), Geometry::MESH) {}
 
+bool Mesh::set_tet_cage_geometry(const TetCageGeometry &geometry, const uint32_t tetrahedron_index)
+{
+  if (tet_cage_geometry_ || tetrahedron_index >= geometry.tetrahedron_count()) {
+    return false;
+  }
+
+  vector<const TetCageMicroTriangle *> selected_triangles;
+  for (const TetCageMicroTriangle &micro_triangle : geometry.micro_triangles()) {
+    if (micro_triangle.tetrahedron_index == tetrahedron_index) {
+      selected_triangles.push_back(&micro_triangle);
+    }
+  }
+
+  if (selected_triangles.empty()) {
+    return false;
+  }
+
+  resize_mesh(int(selected_triangles.size() * 3), int(selected_triangles.size()));
+  packed_float3 *positions = get_position_for_write();
+  int *triangle_indices = get_triangles().data();
+  int *shader_indices = get_shader().data();
+  bool *smooth_flags = get_smooth().data();
+
+  for (size_t triangle_index = 0; triangle_index < selected_triangles.size(); triangle_index++) {
+    const TetCageMicroTriangle &micro_triangle = *selected_triangles[triangle_index];
+    const size_t vertex_index = triangle_index * 3;
+    positions[vertex_index + 0] = micro_triangle.vertices[0];
+    positions[vertex_index + 1] = micro_triangle.vertices[1];
+    positions[vertex_index + 2] = micro_triangle.vertices[2];
+
+    triangle_indices[vertex_index + 0] = int(vertex_index + 0);
+    triangle_indices[vertex_index + 1] = int(vertex_index + 1);
+    triangle_indices[vertex_index + 2] = int(vertex_index + 2);
+    shader_indices[triangle_index] = 0;
+    smooth_flags[triangle_index] = false;
+  }
+
+  tet_cage_geometry_ = make_unique<TetCageGeometry>(geometry);
+  tet_cage_micro_triangles_.clear();
+  tet_cage_micro_triangles_.reserve(selected_triangles.size());
+  for (const TetCageMicroTriangle *micro_triangle : selected_triangles) {
+    tet_cage_micro_triangles_.push_back(*micro_triangle);
+  }
+  tet_cage_tetrahedron_index_ = tetrahedron_index;
+
+  tag_triangles_modified();
+  tag_shader_modified();
+  tag_smooth_modified();
+  return true;
+}
+
 void Mesh::add_builtin_attributes()
 {
   attributes.add(ATTR_STD_POSITION);
@@ -394,6 +445,10 @@ void Mesh::clear(bool preserve_shaders, bool preserve_voxel_data)
