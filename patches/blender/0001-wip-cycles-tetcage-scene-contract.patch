diff --git a/intern/cycles/scene/mesh.cpp b/intern/cycles/scene/mesh.cpp
index 089ce24ff0898f6ccb0c15af4f05e48471afcc3d..4437e5c07af22ee6e635b16eecceebdcc8a1e381 100644
--- a/intern/cycles/scene/mesh.cpp
