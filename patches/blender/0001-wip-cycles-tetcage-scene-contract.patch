+/* SPDX-FileCopyrightText: 2026 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#include "scene/tetcage.h"
+
+CCL_NAMESPACE_BEGIN
+
+bool TetCageGeometry::set_micro_triangles(const vector<TetCageMicroTriangle> &micro_triangles,
+                                          const uint32_t tetrahedron_count)
+{
+  if (micro_triangles_initialized_) {
+    return false;
+  }
+
+  for (const TetCageMicroTriangle &micro_triangle : micro_triangles) {
+    if (micro_triangle.tetrahedron_index >= tetrahedron_count) {
+      return false;
+    }
+  }
+
+  tetrahedron_count_ = tetrahedron_count;
+  micro_triangles_ = micro_triangles;
+  micro_triangles_initialized_ = true;
+  return true;
+}
+
+bool TetCageGeometry::set_frame_tetrahedron_transforms(
+    const vector<Transform> &tetrahedron_transforms)
+{
+  if (!micro_triangles_initialized_ || tetrahedron_transforms.size() != tetrahedron_count_) {
+    return false;
+  }
+
+  frame_tetrahedron_transforms_ = tetrahedron_transforms;
+  return true;
+}
+
+void TetCageGeometry::set_fallback_state(const TetCageFallbackState fallback_state)
+{
+  fallback_state_ = fallback_state;
+}
+
+bool TetCageGeometry::has_micro_triangles() const
+{
+  return !micro_triangles_.empty();
+}
+
+uint32_t TetCageGeometry::tetrahedron_count() const
+{
+  return tetrahedron_count_;
+}
+
+const vector<TetCageMicroTriangle> &TetCageGeometry::micro_triangles() const
+{
+  return micro_triangles_;
+}
+
+const vector<Transform> &TetCageGeometry::frame_tetrahedron_transforms() const
+{
+  return frame_tetrahedron_transforms_;
+}
+
+TetCageFallbackState TetCageGeometry::fallback_state() const
+{
+  return fallback_state_;
+}
+
+CCL_NAMESPACE_END
